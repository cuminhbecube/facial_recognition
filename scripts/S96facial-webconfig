#!/bin/sh

stop_webconfig() {
    killall fr-webconfig 2>/dev/null || true
    # The server exits its blocking accept() cleanly after SIGTERM.  Wait until
    # it releases TCP/80 before starting its replacement.
    attempts=0
    while killall -0 fr-webconfig 2>/dev/null; do
        attempts=$((attempts + 1))
        [ "$attempts" -ge 20 ] && return 1
        sleep 1
    done
}

start_webconfig() {
    # Detach from an interactive SSH session as well as from the boot script.
    nohup /oem/usr/bin/fr-webconfig >/tmp/fr-webconfig.log 2>&1 &
}

case "$1" in
    start) start_webconfig ;;
    stop) stop_webconfig ;;
    restart) stop_webconfig && start_webconfig ;;
esac
