# Rockchip RV1106 Luckfox SDK — Facial Recognition firmware
# Kept source-only: build artifacts are regenerated by ./build.sh.

# Generated firmware & build outputs
Upgrade/
www/
video/
audio/
bin/
output/image/
output/out/*/
output/out/app_out/
output/out/oem/
output/out/rootfs*/
output/out/ramdisk/
output/out/sysdrv_out/
output/out/userdata/
output/out/media_out/rkisp_demo/
output/out/media_out/rga_samples/

# Keep the prebuilt media_out tree the FR app links against
!output/out/media_out/

# sysdrv build products
sysdrv/out/
sysdrv/source/objs_kernel/
sysdrv/source/buildroot/buildroot-2024.02.10/output/
sysdrv/source/buildroot/buildroot-2024.02.10/target/
sysdrv/source/buildroot/buildroot-2024.02.10/host/

# media out trees (media/out is a duplicate of output/out/media_out)
media/out/
media/*/out/

# per-app staged outputs
project/app/*/out/
project/app/facial_recognition/out/

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store

