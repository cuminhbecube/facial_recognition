{
  "camera": {
    "cam0": {
      "enabled": true,
      "name": "OV8858",
      "type": "mipi_csi",
      "sensor": "ov8858",
      "role": "front",
      "vi_dev": 0,
      "vi_pipe": 0,
      "venc_chn": 0,
      "width": 1280,
      "height": 720,
      "fps": 15,
      "bitrate_kbps": 1024
    },
    "cam1": {
      "enabled": true,
      "name": "GC2053",
      "type": "mipi_csi",
      "sensor": "gc2053",
      "role": "rear",
      "vi_dev": 1,
      "vi_pipe": 1,
      "venc_chn": 1,
      "width": 1280,
      "height": 720,
      "fps": 15,
      "bitrate_kbps": 800
    }
  },
  "recording": {
    "codec": "h265",
    "segment_seconds": 180,
    "storage_mount": "/mnt/sdcard"
  },
  "optional_features": {
    "osd": true,
    "rtsp": true,
    "web": true,
    "snapshot": false,
    "audio": false,
    "gps": true,
    "modem": true,
    "substream": true
  },
  "gps": {
    "source": "ec25_usb",
    "usb_vid": "2c7c",
    "usb_pid": "0125",
    "at_port": "auto",
    "nmea_port": "auto",
    "update_interval_ms": 1000,
    "stale_timeout_ms": 5000,
    "allow_qgpsloc_fallback": false
  },
  "stream": {
    "enabled": true,
    "protocol": "rtsp",
    "bind_address": "0.0.0.0",
    "port": 554,
    "queue_max_packets": 60,
    "cam0_main": "/live/cam0/main",
    "cam1_main": "/live/cam1/main",
    "cam0_sub": "/live/cam0/sub",
    "cam1_sub": "/live/cam1/sub"
  },
  "web": {
    "enabled": true,
    "port": 80,
    "video_preview": false,
    "status_poll_seconds": 5,
    "session_timeout_seconds": 1800,
    "max_sessions": 8
  },
  "substream": {
    "codec": "h264",
    "width": 640,
    "height": 360,
    "fps": 12,
    "bitrate_kbps": 500,
    "max_bitrate_kbps": 800,
    "gop": 24
  }
}
